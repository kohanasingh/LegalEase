# Backend image for Render (ARCHITECTURE.md §6, BUILD_INSTRUCTIONS.md Stage 7).
#
# Bakes corpus/chroma_data/ into the image at build time rather than writing
# it at runtime — Render's free web services have an ephemeral filesystem,
# and the legal corpus is static (CLAUDE.md non-negotiable #3).
#
# Build context must be the repo root, e.g.:
#   docker build -f deployment/Dockerfile.backend -t legalease-backend .

FROM python:3.12-slim

WORKDIR /app

COPY backend/requirements.txt ./backend/requirements.txt

# fastembed (ONNX-only, no torch — see CHANGES.md for why sentence-transformers
# was replaced: its own package unconditionally imports torch regardless of
# backend choice, which alone pushed peak memory over Render's 512MB free-tier
# cap) needs no special install handling, unlike the old torch-backed setup.
RUN pip install --no-cache-dir --retries 5 --timeout 120 -r backend/requirements.txt

COPY backend ./backend
COPY corpus/chroma_data ./corpus/chroma_data

ENV CHROMA_PERSIST_DIR=/app/corpus/chroma_data
ENV PYTHONUNBUFFERED=1
ENV FASTEMBED_CACHE_PATH=/app/.cache/fastembed

# Pre-download the embedding model into the image at build time. Without
# this, the first request after every cold start (Render's free tier sleeps
# after 15min idle) would block on downloading it from HuggingFace Hub —
# slow, and a dependency on HF Hub being reachable at runtime for no reason.
RUN python -c "from fastembed import TextEmbedding; TextEmbedding('BAAI/bge-small-en-v1.5')"

EXPOSE 8000

# Render sets $PORT at runtime; default to 8000 for local `docker run`.
CMD ["sh", "-c", "uvicorn backend.main:app --host 0.0.0.0 --port ${PORT:-8000}"]
